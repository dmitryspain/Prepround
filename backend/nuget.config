<?xml version="1.0" encoding="utf-8"?>
<!-- Single source with mapping: central package management requires it (NU1507), and it rules out
     machine-level feeds leaking into restore (reproducible builds, no dependency confusion). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
